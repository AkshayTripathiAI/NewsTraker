# Copy to .env and fill in. .env is git-ignored.

# Server (api/index.js)
NEWS_API_KEY=your-newsapi-key
PORT=3001
# Optional: two-letter country code for top headlines (default: us)
NEWS_COUNTRY=us
# Optional: restrict CORS to the frontend origin (default: *)
# CORS_ORIGIN=http://localhost:3000

# Frontend (read at build/start time by Create React App)
REACT_APP_API_URL=http://localhost:3001
